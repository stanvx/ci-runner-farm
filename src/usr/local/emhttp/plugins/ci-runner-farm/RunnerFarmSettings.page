<?php
include_once '/usr/local/emhttp/plugins/ci-runner-farm/include/crf-core.php';
include_once '/usr/local/emhttp/plugins/ci-runner-farm/include/crf-fields.php';
/* CI Runner Farm settings: the HOST-WIDE layer, and nothing else.
   One install hosts N fleets, and the engine assembles each one from two fixed layers
   (runner-farm.sh GLOBAL_KEYS / FLEET_KEYS). This tab owns the global layer — the keys
   that describe the BOX rather than a fleet: one cache root, one pull-through mirror,
   one host `docker login`, one dashboard tile, and the two secrets. Everything a single
   fleet decides for itself moved to that fleet's own configuration column on the Fleet
   tab, where the fleet it applies to is the one you can see.

   The crf* JS core (crfPost, CRF_DEFAULTS), the shared .crf-* styles and the config-form
   styles all come from include/crf-core.php (shared by every tab via include_once). */
$plugin     = 'ci-runner-farm';
/* parse_plugin_cfg reads /boot/config/plugins/$plugin/$plugin.cfg (empty [] if absent).
   That file is BOTH the global layer and fleet `default`'s own layer — which is exactly
   why upgrading a single-fleet install writes nothing. crf_cfg_read narrows it to the
   global keys, so this form can never render or save a per-fleet value. Defaults are NOT
   stored on flash — they live in $crf_defaults (include/crf-config.php), so the flash cfg
   only ever holds what the operator actually changed. */
$cfg        = crf_cfg_read('default', 'global');
$has_token  = file_exists("/boot/config/plugins/$plugin/token");
$has_regtok = file_exists("/boot/config/plugins/$plugin/registry-token");
/* PAT scope follows fleet `default`'s GH_SCOPE: the token is host-wide, so the link can
   only pre-scope for one fleet, and `default` always exists. An org fleet added later
   needs admin:org — the help text below says so rather than the link silently lying. */
$legacy     = parse_plugin_cfg($plugin);
$patScope   = (($legacy['GH_SCOPE'] ?? $crf_defaults['GH_SCOPE']) === 'org') ? 'repo,admin:org' : 'repo';
$patUrl     = 'https://github.com/settings/tokens/new?description=Unraid+CI+Runner+Farm&scopes='.$patScope;
?>
<link type="text/css" rel="stylesheet" href="<?autov('/webGui/styles/jquery.filetree.css')?>">
<script src="<?autov('/webGui/javascript/jquery.filetree.js')?>" charset="utf-8"></script>
<div class="crfs-tokband<?= $has_token ? '' : ' crfs-tokband-missing' ?>" id="crf-tokband">
  <div class="crfs-tok-status">
    <span class="crf-ball <?= $has_token ? 'crf-ball-idle' : 'crf-ball-error' ?>" id="crf-tok-ball"></span>
    <span class="crfs-tok-text">
      <strong id="crf-tok"><?= $has_token ? 'GitHub token configured' : 'GitHub token not set' ?></strong>
      <span class="crfs-tok-sub" id="crf-tok-sub"><?= $has_token ? 'Stored at /boot/config/plugins/ci-runner-farm/token (chmod 600), never in ci-runner-farm.cfg.' : 'The farm cannot register runners until a token is saved.' ?></span>
    </span>
  </div>
  <div class="crfs-tok-input">
    <uui-button variant="outline" size="xs" onclick="window.open('<?=$patUrl?>','_blank','noopener')">Get a pre-scoped PAT &#8599;</uui-button>
    <span class="crfs-field"><input type="password" id="crf-token" autocomplete="new-password" placeholder="ghp_... (scopes pre-filled)"><button type="button" class="crfs-fx" title="Clear saved token" aria-label="Clear saved token" onclick="crfClearToken()">&times;</button></span>
    <uui-button size="xs" onclick="crfSetToken()">Save token</uui-button>
  </div>
</div>
<blockquote class="inline_help"><p>One PAT for every fleet on this box. It stays host-side: runners are handed a short-lived registration token, never the PAT itself. Scope is <code>repo</code>, plus <code>admin:org</code> if any fleet registers at org scope.</p></blockquote>

<div class="crfs-tokband crfs-regband" id="crf-remote-auth">
  <div class="crfs-tok-status">
    <span class="crf-ball <?= $has_regtok ? 'crf-ball-idle' : '' ?>" id="crf-regtok-ball"></span>
    <span class="crfs-tok-text">
      <strong id="crf-regtok"><?= $has_regtok ? 'Registry token configured' : 'Registry token not set' ?></strong>
      <span class="crfs-tok-sub">Password/token for the private registry (e.g. a PAT with read:packages for ghcr.io). For ghcr.io, leaving it blank reuses the GitHub PAT.</span>
    </span>
  </div>
  <div class="crfs-tok-input">
    <span class="crfs-field"><input type="password" id="crf-registry-token" autocomplete="new-password" placeholder="registry password / token"><button type="button" class="crfs-fx" title="Clear saved registry token" aria-label="Clear saved registry token" onclick="crfClearRegistryToken()">&times;</button></span>
    <uui-button size="xs" onclick="crfSetRegistryToken()">Save registry token</uui-button>
  </div>
</div>

<div class="crf-cfg" id="crf-glob">
  <div class="crf-cfg-head">
    <h2 class="crf-cfg-title">Host settings</h2>
    <span class="crf-muted crf-cfg-for">These apply to the whole box &mdash; every fleet shares them. Runners, capacity, image, isolation and caches are per fleet, on the <b>Fleet</b> tab.</span>
  </div>
  <!-- Server-rendered with real values, unlike the Fleet tab's column: the global layer
       is the same file whatever fleet the browser has selected, so PHP can read it. -->
  <form id="crf-glob-form" onsubmit="return false">
    <fieldset class="crf-cfg-fs">
      <?php crf_render_fields('global', $cfg); ?>
      <div class="crf-cfg-actions">
        <uui-button size="sm" onclick="crfGlobSave()">Apply</uui-button>
        <uui-button variant="secondary" size="sm" onclick="crfGlobReset()">Reset to defaults</uui-button>
      </div>
    </fieldset>
  </form>
</div>

<script>
/* Host-wide keys only. Saved through exec.php rather than Unraid's /update.php: that
   takes one hardcoded `#file` and rebuilds it from the posted fields, and this file is
   ALSO fleet `default`'s own cfg — a whole-file rewrite from this form would delete
   every per-fleet key it holds. save-config merges instead (see crf_cfg_merge). */
const CRF_GLOB_KEYS = <?=json_encode(crf_field_keys('global'))?>;
function crfGlobEl(k){ const f=document.getElementById('crf-glob-form'); return f?f.elements[k]:null; }
function crfGlobSave(){
  const cfg={};
  CRF_GLOB_KEYS.forEach(k=>{ const el=crfGlobEl(k); if(el) cfg[k]=el.value; });
  // fleet:'default' is explicit, not the ambient selection: the global layer is one
  // file, and letting the selected fleet ride along would only invite a future reader
  // to think it targets that fleet's cfg.
  crfPost({action:'save-config',layer:'global',fleet:'default',cfg:JSON.stringify(cfg)}).then(o=>{
    if(o.ok===false){ crfToast('Save failed'+(o.error?': '+o.error:'')); return; }
    crfToast('Host settings saved');
  }).catch(e=>{ crfToast('Save failed'); console.error('ci-runner-farm save-config:',e); });
}
/* Client-side only — nothing reaches flash until Apply. */
function crfGlobReset(){
  CRF_GLOB_KEYS.forEach(k=>{ const el=crfGlobEl(k); if(el) el.value=CRF_DEFAULTS[k]??''; });
}
function crfTokState(ok){
  const band=document.getElementById('crf-tokband'), ball=document.getElementById('crf-tok-ball');
  document.getElementById('crf-tok').textContent = ok?'GitHub token configured':'GitHub token not set';
  document.getElementById('crf-tok-sub').textContent = ok?'Stored at /boot/config/plugins/ci-runner-farm/token (chmod 600), never in ci-runner-farm.cfg.':'The farm cannot register runners until a token is saved.';
  band.classList.toggle('crfs-tokband-missing',!ok);
  ball.className='crf-ball '+(ok?'crf-ball-idle':'crf-ball-error');
}
function crfSetToken(){ const t=document.getElementById('crf-token').value; if(!t)return;
  crfPost({action:'set-token',token:t}).then(o=>{ if(o.ok===false){ crfToast(o.error||'Save failed'); return; } crfTokState(true); document.getElementById('crf-token').value=''; }).catch(e=>{ crfToast('Save failed'); console.error('ci-runner-farm set-token:',e); }); }
function crfClearToken(){ crfPost({action:'clear-token'}).then(()=>crfTokState(false)).catch(e=>console.error('ci-runner-farm clear-token:',e)); }
function crfRegState(ok){
  document.getElementById('crf-regtok').textContent = ok?'Registry token configured':'Registry token not set';
  document.getElementById('crf-regtok-ball').className='crf-ball '+(ok?'crf-ball-idle':'');
}
function crfSetRegistryToken(){ const t=document.getElementById('crf-registry-token').value; if(!t)return;
  crfPost({action:'set-registry-token',token:t}).then(o=>{crfRegState(!!o.ok);document.getElementById('crf-registry-token').value='';}).catch(e=>console.error('ci-runner-farm set-registry-token:',e)); }
function crfClearRegistryToken(){ crfPost({action:'clear-registry-token'}).then(()=>crfRegState(false)).catch(e=>console.error('ci-runner-farm clear-registry-token:',e)); }
/* Unraid's folder picker, attached after the page settles. */
document.addEventListener('DOMContentLoaded',()=>{
  if(window.jQuery && $.fn.fileTreeAttach) $("#CACHE_ROOT").fileTreeAttach();
});
</script>

<style>
  .crfs-tokband{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;border:1px solid var(--border-color);border-radius:6px;background:var(--shade-bg-color,transparent);padding:10px 14px;margin:6px 0 4px;max-width:780px;box-sizing:border-box}
  .crfs-regband{margin-top:10px}
  .crfs-tokband-missing{border-color:var(--crf-err);background:color-mix(in srgb,var(--crf-err) 8%,var(--background-color))}
