<?php
/* Main → Dashboard status tile for CI Runner Farm.
 *
 * Deliberately self-contained vanilla JS with no @unraid/ui force-load (unlike
 * the full RunnerFarm tabs) — this renders on every dashboard view, so it stays
 * a few tiles + an EventSource. Live status is PUSHED over the nchan
 * "ci_runner_farm" channel (see nchan/ci_runner_farm); the Nchan= header keeps
 * that publisher alive while this tile is visible. The publisher pushes an
 * AGGREGATE-ONLY payload ({count,up,busy,idle}) — the /sub channel is not behind
 * the webGUI login, so no per-runner repo/branch/job detail is broadcast.
 *
 * The per-fleet breakdown below does NOT ride that channel, and the publisher is
 * unchanged: fleet names are per-install detail, and /sub is unauthenticated on the
 * LAN. Rows are fetched from exec.php instead — same webGUI login, same CSRF gate as
 * every other request this plugin makes.
 *
 * A single-fleet install renders exactly what it rendered before and makes no extra
 * request at all: the fleet count is a glob at render time, and the polling code is
 * only emitted when there is a second fleet to tell apart. */
$crfw_fleets = ['default'];
foreach (glob('/boot/config/plugins/ci-runner-farm/fleets/*.cfg') ?: [] as $f) {
  $n = basename($f, '.cfg');
  if ($n !== 'default' && preg_match('/^[a-z][a-z0-9-]{0,30}$/', $n)) $crfw_fleets[] = $n;
}
$crfw_multi = count($crfw_fleets) > 1;
$crfw_csrf  = $var['csrf_token'] ?? '';
?>
