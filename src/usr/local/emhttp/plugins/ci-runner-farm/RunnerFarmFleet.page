<script>
/* Poll only when the Fleet tab is actually on screen. document.hidden covers a
   backgrounded browser tab; offsetParent covers the inactive dynamix sub-tab
   (all tabs share one document, so document.hidden stays false on Settings/Image
   while Fleet's pollers would otherwise keep hitting docker on the NAS). */
function crfFleetActive(){ const b=document.getElementById('crf-bays-body'); return !document.hidden && !!b && b.offsetParent!==null; }
let crfUserLog=false;
function crfLog(o){ crfUserLog=true; document.getElementById('crf-log').innerHTML = crfColorize(o.log||JSON.stringify(o)); }
/* Until the user triggers an action, the Fleet log shows live farm activity
   (autoscale daemon log) instead of sitting on a placeholder. */
function crfFarmLog(){
  if(crfUserLog||!crfFleetActive()) return;
  crfPost({action:'farm-log'}).then(d=>{
    if(crfUserLog||!d.log) return;
    const el=document.getElementById('crf-log');
    el.innerHTML=crfColorize(d.log); el.scrollTop=el.scrollHeight;
  }).catch(()=>{});
}
crfFarmLog(); setInterval(crfFarmLog,10000);
/* Lightweight theme-following toast for action feedback. */
const CRF_TOAST_MSG={start:'Fleet started',stop:'Fleet stopped',restart:'Fleet restarted',validate:'Validation finished'};
function crfDoAction(a){ crfPost({action:a}).then(o=>{crfLog(o); crfRefresh(); crfFleetList(); if(o.ok!==false) crfToast(CRF_TOAST_MSG[a]||a); else crfToast((CRF_TOAST_MSG[a]||a)+' failed'+(o.error?': '+o.error:'')); }).catch(e=>{ crfToast((CRF_TOAST_MSG[a]||a)+' failed'); console.error('ci-runner-farm '+a+':',e); }); }
function crfAction(a){
  /* Stop/Restart kill whatever the runners are building — confirm with the
     live impact when any runner is mid-job (sweetalert ships with the webgui). */
  if((a==='stop'||a==='restart')&&window.swal){
    const busy=((window.CRF_LAST||{}).runners||[]).filter(r=>r.state==='running'&&r.phase==='busy');
    if(busy.length){
      const lines=busy.map(r=>r.name+(r.job?' — '+r.job:'')).join('\n');
      swal({title:(a==='stop'?'Stop':'Restart')+' the fleet?',
        text:busy.length+' runner'+(busy.length>1?'s are':' is')+' mid-job:\n'+lines+'\n\nTheir jobs will fail and re-queue.',
        type:'warning',showCancelButton:true,confirmButtonText:a==='stop'?'Stop fleet':'Restart fleet',cancelButtonText:'Cancel'},
        ok=>{ if(ok) crfDoAction(a); });
      return;
    }
  }
  crfDoAction(a);
}
function crfScale(){ const n=document.getElementById('crf-n').value; crfPost({action:'scale',n}).then(o=>{crfLog(o); crfRefresh(); if(o.ok!==false) crfToast('Scaled to '+n); else crfToast('Scale failed'+(o.error?': '+o.error:''));}).catch(e=>{ crfToast('Scale failed'); console.error('ci-runner-farm scale:',e); }); }

/* ---- fleet navigation ---------------------------------------------------
   The rail, the identity header and the state-chosen primary action. The
   selected fleet itself lives in crf-core.php (crfFleet/crfSetFleet), which
   also stamps it onto every crfPost — nothing here threads it by hand. */
window.CRF_FLEETS=[];
/* Declared up here, not beside the configuration code below, because crfSelectFleet
   reads it and the 30s fleet-list poller can call that before this script has finished
   executing — a `let` in its original place would be in the temporal dead zone. */
let crfCfgDirty=false;
const CRF_HEALTH_LABEL={healthy:'Healthy',active:'Handing over',degraded:'Degraded',failed:'Failed',stopped:'Stopped'};
/* Colour means health only. `active` (blue) is a fleet mid-handover: it is doing
   something deliberate, not something wrong, so it must not read as degraded. */
function crfHealth(f){
  if(f.draining_to) return 'active';
  const run=+f.running||0, cfg=+f.configured||0;
  if(run===0) return 'stopped';
  return run<cfg ? 'degraded' : 'healthy';
}
function crfRailRow(f){
  const h=crfHealth(f), on=f.name===crfFleet();
  return '<div class="crf-rail-row'+(on?' on':'')+'" tabindex="0" role="button" aria-current="'+(on?'true':'false')+'" data-fleet="'+crfEsc(f.name)+'">'+
    '<span class="crf-ball crf-h-'+h+'" title="'+CRF_HEALTH_LABEL[h]+'"></span>'+
    '<span class="crf-rail-n">'+crfEsc(f.name)+'</span>'+
    '<span class="crf-rail-sub">'+(+f.running||0)+'/'+(+f.configured||0)+(f.draining_to?' · → '+crfEsc(f.draining_to):'')+'</span>'+
  '</div>';
}
function crfRenderRail(){
  const rail=document.getElementById('crf-rail'), body=document.getElementById('crf-rail-body');
  if(!rail||!body) return;
  // One fleet means no navigation to do — an install that never adds a second
  // fleet sees the page exactly as it was before any of this existed.
  rail.hidden = window.CRF_FLEETS.length < 2;
  body.innerHTML = window.CRF_FLEETS.map(crfRailRow).join('');
}
function crfRenderIdentity(){
  const f=window.CRF_FLEETS.find(x=>x.name===crfFleet())||{name:crfFleet(),running:0,configured:0,mode:'legacy'};
  const h=crfHealth(f), cfg=+f.configured||0;
  const nm=document.getElementById('crf-id-name'); if(nm) nm.textContent=f.name;
  const st=document.getElementById('crf-id-status');
  // 'scale-set' with the hyphen is the engine's literal (FLEET_MODE in runner-farm.sh, the
  // select value in crf-fields.php). Spelt 'scaleset' here, every scale-set fleet read back
  // as "Legacy registration".
  if(st) st.innerHTML='<span class="crf-ball crf-h-'+h+'"></span><b>'+CRF_HEALTH_LABEL[h]+'</b>'+
    '<span class="crf-sep">·</span><span>'+(+f.running||0)+' of '+cfg+' runner'+(cfg===1?'':'s')+'</span>'+
    '<span class="crf-sep">·</span><span class="crf-muted">'+(f.mode==='scale-set'?'Scale set':'Legacy registration')+'</span>';
  const dr=document.getElementById('crf-drain');
  if(dr){
    if(f.draining_to){ dr.textContent='⟳ '+f.name+' is being renamed to '+f.draining_to+' — runners move across as they go idle, and '+f.name+' disappears once its last one is gone.'; dr.style.display='block'; }
    else { dr.textContent=''; dr.style.display='none'; }
  }
  // Fleet `default` IS the legacy config path — the engine refuses to rename or delete
  // it, so the menu does not offer what it would only refuse.
  const legacy=f.name==='default';
  const mr=document.getElementById('crf-menu-rename'); if(mr) mr.hidden=legacy;
  const md=document.getElementById('crf-menu-delete'); if(md) md.hidden=legacy;
  const p=document.getElementById('crf-primary');
  if(p){
    // Mid-handover the engine refuses to refill this fleet (cmd_start resumes the
    // drain instead), so offering Start here would be a button that does nothing.
    if(f.draining_to){ p.textContent='Handing over…'; p.setAttribute('disabled',''); }
    else { p.removeAttribute('disabled'); p.textContent=(+f.running||0)===0?'Start fleet':'Stop fleet'; }
  }
}
function crfPrimary(){
  const f=window.CRF_FLEETS.find(x=>x.name===crfFleet())||{};
  if(f.draining_to) return;
  crfAction((+f.running||0)===0?'start':'stop');
}
function crfMenuOpen(v){
  const m=document.getElementById('crf-menu'), b=document.getElementById('crf-menu-btn');
  if(!m) return;
  m.hidden=!v;
  if(b) b.setAttribute('aria-expanded', v?'true':'false');
}
function crfMenuToggle(){ const m=document.getElementById('crf-menu'); if(m) crfMenuOpen(m.hidden); }
function crfMenuPick(a){ crfMenuOpen(false); crfAction(a); }
document.addEventListener('click',e=>{ if(!e.target.closest('.crf-menu')) crfMenuOpen(false); });
document.addEventListener('keydown',e=>{ if(e.key==='Escape') crfMenuOpen(false); });

function crfSelectFleet(name){
  if(!name||name===crfFleet()) return;
  // The configuration column belongs to the fleet we are leaving, and switching
  // reloads it from the new fleet's cfg. Unapplied edits would vanish with no trace,
  // so they are the one thing a switch asks about.
  if(crfCfgDirty&&!window.confirm('Discard the unapplied configuration changes for '+crfFleet()+'?')) return;
  crfSetFleet(name);
  // Every cache on this page belongs to the fleet we just left — the runner rows,
  // the open log drawer, the cache figure and the action log. Drop them all rather
  // than showing another fleet's numbers under this fleet's name for one poll.
  window.CRF_LAST=null; window.CRF_CACHE=null;
  window.CRF_DRAWER=null; window.CRF_DRAWER_HTML=''; window.CRF_DRAWER_SCROLL=0; window.CRF_DRAWER_PINNED=true;
  window.CRF_QUEUED=undefined; window.CRF_QUEUED_AGE=undefined; window.CRF_UP=0;
  crfUserLog=false;
  // Nulling the caches alone leaves the PREVIOUS fleet's figures painted under the
  // new fleet's name — the queue and storage cards only repaint on their own 30s
  // pollers, so blank them by hand rather than waiting.
  ['crf-cap-v','crf-q-v','crf-st-v'].forEach(i=>{const e=document.getElementById(i); if(e) e.textContent='–';});
  ['crf-cap-s','crf-q-s','crf-st-s','crf-cap-mode','crf-cap-iu'].forEach(i=>{const e=document.getElementById(i); if(e) e.textContent='';});
  const cd=document.getElementById('crf-cap-dead'); if(cd) cd.hidden=true;
  const cc=document.getElementById('crf-cache-clear'); if(cc) cc.title='';
  const po=document.getElementById('crf-posture');
  if(po){ po.className='crf-posture crf-p-unknown'; po.innerHTML='<b>Checking…</b>'; }
  const tb=document.getElementById('crf-bays-body');
  if(tb){ tb.__crfSig=null; tb.innerHTML='<div class="crf-bay"><span></span><span class="crf-muted">loading...</span><span></span><span></span><span></span><span></span><span></span></div>'; }
  crfRenderRail(); crfRenderIdentity();
  crfRefresh(); crfQueued(); crfCacheUsage(); crfStats(); crfFarmLog(); crfCfgLoad();
}
document.getElementById('crf-rail-body').addEventListener('click',e=>{
  const row=e.target.closest('.crf-rail-row[data-fleet]'); if(row) crfSelectFleet(row.dataset.fleet);
});
document.getElementById('crf-rail-body').addEventListener('keydown',e=>{
  if(e.key!=='Enter'&&e.key!==' ') return;
  const row=e.target.closest('.crf-rail-row[data-fleet]'); if(!row) return;
  e.preventDefault(); crfSelectFleet(row.dataset.fleet);
});
/* fleets-json is host-wide, so it names its own target rather than inheriting the
   selection. It fans out one engine re-exec per fleet, hence 30s — the 5s status
   poll stays single-fleet, so poll cost does not grow with the number of fleets. */
function crfFleetList(){
  if(!crfFleetActive()) return;
  crfPost({action:'fleets-json',fleet:'default'}).then(d=>{
    window.CRF_FLEETS=d.fleets||[];
    // A fleet remembered in localStorage may have been renamed or deleted since. The
    // engine resolves an unknown --fleet to an absent cfg and silently runs on
    // defaults, so fall back to a real fleet instead of operating on a ghost.
    if(window.CRF_FLEETS.length && !window.CRF_FLEETS.some(f=>f.name===crfFleet())) crfSelectFleet(window.CRF_FLEETS[0].name);
    crfRenderRail(); crfRenderIdentity();
  }).catch(()=>{});
}
crfFleetList(); setInterval(crfFleetList,30000);

/* ---- fleet lifecycle ----------------------------------------------------
   Thin wrappers over the fleet-create / fleet-rename / fleet-delete verbs the engine
   already owns. Every refusal (fleet exists, still has containers, already renaming)
   is the ENGINE's sentence, surfaced verbatim — re-deciding those rules here would
   give the operator two answers that could disagree. */
const CRF_FLEET_RE=/^[a-z][a-z0-9-]{0,30}$/;   // same shape the engine and exec.php enforce
const CRF_NAME_HINT='Lowercase letter first, then letters, digits or dashes (max 31 characters).';
function crfAskName(title,text,def,cb){
  if(window.swal){
    swal({title,text,type:'input',showCancelButton:true,closeOnConfirm:false,inputValue:def||'',inputPlaceholder:'e.g. release'},v=>{
      if(v===false) return;
      const n=String(v||'').trim();
      if(!CRF_FLEET_RE.test(n)){ swal.showInputError(CRF_NAME_HINT); return; }
      swal.close(); cb(n);
    });
    return;
  }
  const n=String(window.prompt(text+'\n'+CRF_NAME_HINT,def||'')||'').trim();
  if(CRF_FLEET_RE.test(n)) cb(n);
}
function crfFleetVerb(action,name,onOk){
  crfPost({action,name}).then(o=>{
    if(o.ok===false){ crfToast(o.error||(action+' failed')); return; }
    onOk(o);
  }).catch(e=>{ crfToast(action+' failed'); console.error('ci-runner-farm '+action+':',e); });
}
function crfFleetAdd(){
  crfMenuOpen(false);
  crfAskName('Add a fleet','A new fleet starts empty — every setting at its built-in default — and owns its own runners, network and image.','',n=>{
    crfFleetVerb('fleet-create',n,()=>{ crfToast('Fleet '+n+' created'); crfSelectFleet(n); crfFleetList(); });
  });
}
function crfFleetRename(){
  crfMenuOpen(false);
  const from=crfFleet();
  if(from==='default'){ crfToast('Fleet default cannot be renamed — it is the legacy config path'); return; }
  crfAskName('Rename '+from,'A fleet with runners up is HANDED OVER rather than renamed in place: runners move to the new name as they go idle, so no in-flight job is killed.',from,n=>{
    crfFleetVerb('fleet-rename',n,o=>{
      crfToast(o.draining ? 'Handing '+o.runners+' runner(s) over to '+n : 'Renamed to '+n);
      // Mid-handover BOTH fleets are real, and the old one is the draining source the
      // banner explains — so only jump to the new name once the rename was instant.
      if(!o.draining) crfSelectFleet(n);
      crfFleetList();
    });
  });
}
function crfFleetDelete(){
  crfMenuOpen(false);
  const f=crfFleet();
  if(f==='default'){ crfToast('Fleet default cannot be deleted — it is the legacy config path'); return; }
  const go=()=>crfFleetVerb('fleet-delete',f,()=>{ crfToast('Fleet '+f+' deleted'); crfSelectFleet('default'); crfFleetList(); });
  // The engine refuses while the fleet still owns containers, so this confirms the
  // loss of its CONFIG — the one thing delete actually destroys.
  if(window.swal){
    swal({title:'Delete '+f+'?',text:'Its configuration is removed from the flash drive. The fleet must already be stopped; its caches on the pool are left alone.',
      type:'warning',showCancelButton:true,confirmButtonText:'Delete fleet',cancelButtonText:'Cancel'},ok=>{ if(ok) go(); });
  } else if(window.confirm('Delete fleet '+f+'? Its configuration is removed from the flash drive.')) go();
}

/* ---- configuration layer -------------------------------------------------
   The selected fleet's own keys. Rendered by PHP with DEFAULTS only (the selection
   lives in localStorage, which PHP has not been told), then filled from get-config and
   enabled — so the operator never edits, or Applies, a value that only looked stored. */
const CRF_CFG_KEYS = <?=json_encode(crf_field_keys('fleet'))?>;
const CRF_HOST_GB  = <?=$host_mem_gb ?: 0?>;
function crfCfgEl(k){ const f=document.getElementById('crf-cfg-form'); return f?f.elements[k]:null; }
/* A bare #anchor href would put the fragment in the URL, and Dynamix routes on it —
   scroll by hand instead. */
function crfCfgFocusSecurity(){
  const s=document.getElementById('crf-cfg-security');
  if(s) s.scrollIntoView({behavior:'smooth',block:'start'});
}
function crfCfgLoad(){
  const fs=document.getElementById('crf-cfg-fs'); if(!fs) return;
  fs.disabled=true; crfCfgDirty=false;
  crfPost({action:'get-config',layer:'fleet'}).then(d=>{
    // crfPost drops a response whose `fleet` field disagrees with the request —
    // a switch while the request was in flight would otherwise paint the previous
    // fleet's values under the new fleet's name, and the next Apply would write
    // them there. The label reads d.fleet (not crfFleet()) for the same reason:
    // the response is the truth of which fleet answered.
    const cfg=d.cfg||{};
    CRF_CFG_KEYS.forEach(k=>{ const el=crfCfgEl(k); if(el) el.value=(k in cfg)?cfg[k]:(CRF_DEFAULTS[k]??''); });
    const lbl=document.getElementById('crf-cfg-for'); if(lbl) lbl.textContent=d.fleet;
    fs.disabled=false; crfCfgCredentialButton(); crfCfgAdvise();
  }).catch(e=>{ if(e&&e.__crfStale) return; console.error('ci-runner-farm get-config:',e); });
}
function crfCfgCredentialButton(){
  const row=document.querySelector('#crf-cfg [data-key="GH_CREDENTIAL"]'), dd=row&&row.querySelector('dd');
  if(!dd||dd.querySelector('.crf-credential-test')) return;
  const b=document.createElement('button'); b.type='button'; b.className='crf-credential-test'; b.textContent='Test';
  b.addEventListener('click',crfCfgCheckCredential); dd.appendChild(b);
}
function crfCfgCheckCredential(){
  const input=crfCfgEl('GH_CREDENTIAL'), b=document.querySelector('.crf-credential-test'), name=input&&input.value.trim();
  if(!name){ crfToast('Enter a credential name first'); return; }
  if(b){ b.disabled=true; b.textContent='Checking…'; }
  crfPost({action:'check-credential',name}).then(o=>{
    if(o.ok===false){ crfToast('Credential check failed'+(o.error?': '+o.error:'')); return; }
    const who=o.account||'unknown account', kind=o.type==='app'?'GitHub App':'PAT';
    crfToast('Credential valid: '+who+' ('+kind+')');
  }).catch(e=>{ crfToast('Credential check failed'); console.error('ci-runner-farm check-credential:',e); })
    .finally(()=>{ if(b){ b.disabled=false; b.textContent='Test'; } });
}
function crfCfgSave(){
  const cfg={};
  CRF_CFG_KEYS.forEach(k=>{ const el=crfCfgEl(k); if(el) cfg[k]=el.value; });
  crfPost({action:'save-config',layer:'fleet',cfg:JSON.stringify(cfg)}).then(o=>{
    if(o.ok===false){ crfToast('Save failed'+(o.error?': '+o.error:'')); return; }
    crfCfgDirty=false;
    crfToast('Configuration saved');
    // The reconciler is already running; the status poll paints its "migrating" count.
    crfRefresh(); crfFleetList();
  }).catch(e=>{ crfToast('Save failed'); console.error('ci-runner-farm save-config:',e); });
}
/* Client-side only — nothing reaches flash until Apply. */
function crfCfgReset(){
  CRF_CFG_KEYS.forEach(k=>{ const el=crfCfgEl(k); if(el) el.value=CRF_DEFAULTS[k]??''; });
  crfCfgDirty=true; crfCfgAdvise();
}
/* The remote image ref is meaningless on a built-in fleet — hide it (and its help)
   rather than leaving a field that is silently ignored. */
function crfCfgImgSrc(){
  const sel=crfCfgEl('IMAGE_SOURCE'), row=document.querySelector('#crf-cfg [data-key="IMAGE"]');
  if(!sel||!row) return;
  const show=sel.value==='remote', disp=show?'':'none';
  row.style.display=disp;
  const help=row.nextElementSibling;
  if(help&&help.classList.contains('inline_help')) help.style.display=disp;
}
/* Two advisories, both worth more than the number they sit next to: an autoscale range
   that can never settle, and a fleet whose worst-case memory exceeds the box. Docker's
   -m accepts a unit suffix, so "512m" is half a gig, not 512 GB; a bare number is read
   as GB to match the rest of this form's convention. */
function crfCfgParseGb(v){
  const m=String(v||'').trim().match(/^([0-9]*\.?[0-9]+)\s*([kmgt]?)b?$/i);
  return m ? parseFloat(m[1])*({k:1/1048576,m:1/1024,g:1,t:1024}[(m[2]||'g').toLowerCase()]||1) : 0;
}
function crfCfgAdvise(){
  crfCfgImgSrc();
  const min=crfCfgEl('AUTOSCALE_MIN'), max=crfCfgEl('AUTOSCALE_MAX'), w=document.getElementById('crf-cfg-aswarn');
  if(min&&max&&w) w.classList.toggle('on',(+min.value||0)>(+max.value||0));
  const mem=crfCfgEl('RUNNER_MEMORY'), cnt=crfCfgEl('RUNNER_COUNT'), as=crfCfgEl('AUTOSCALE'), n=document.getElementById('crf-cfg-memwarn');
  if(!mem||!cnt||!n||!CRF_HOST_GB) return;
  const g=crfCfgParseGb(mem.value);
  const runners=(as&&as.value==='true')?(+((max||{}).value)||0):(+cnt.value||0);
  const worst=g*runners, fmt=x=>x.toFixed(1).replace(/\.0$/,'');
  n.textContent='Worst case '+runners+' × '+fmt(g)+'g = '+fmt(worst)+'g of this host’s '+CRF_HOST_GB+'g — '+fmt(CRF_HOST_GB-worst)+'g left for everything else. These are caps, not reservations.';
  n.classList.toggle('on',worst>CRF_HOST_GB*0.8);
}
(function(){
  const f=document.getElementById('crf-cfg-form'); if(!f) return;
  ['input','change'].forEach(ev=>f.addEventListener(ev,()=>{ crfCfgDirty=true; crfCfgAdvise(); }));
})();
crfCfgLoad();

function crfElapsed(iso){
  const t=Date.parse(iso); if(isNaN(t)) return null;
  const m=Math.floor((Date.now()-t)/60000);
  return {m, txt: m<1?'<1m': m<60? m+'m' : Math.floor(m/60)+'h'+String(m%60).padStart(2,'0')};
}
function crfBar(pct){
  const p=Math.max(0,Math.min(100,Math.round(pct)));
  const cls=p>90?' crf-hot':p>60?' crf-mid':'';
  return '<span class="crf-ubar'+cls+'"><span style="width:'+p+'%"></span></span>';
}
/* The per-poll VOLATILE cells — the elapsed timer and the CPU/mem bars, which tick
   every 5s for a busy runner. Factored out so the full row builder and crfRefresh's
   in-place fast-path render them identically from ONE source of truth (no drift). */
function crfVolatile(r){
  const running=r.state==='running';
  let elapsedHtml='';
  if(running&&r.phase==='busy'&&r.job_started){
    const e=crfElapsed(r.job_started);
    if(e) elapsedHtml=' <span class="crf-elapsed'+(e.m>=120?' crf-el-hot':e.m>=30?' crf-el-warn':'')+'" title="running for '+e.txt+'">'+e.txt+'</span>';
  }
  const cpuMax=(r.cpus&&r.cpus>0)?r.cpus*100:100;
  const cpuKnown=running&&r.cpu_pct>=0, memKnown=running&&r.mem_used_mib>=0&&r.mem_gb;
  const cpuPct=cpuKnown?(100*r.cpu_pct/cpuMax):0;
  const memPct=memKnown?100*r.mem_used_mib/(r.mem_gb*1024):0;
  const cpuTxt=cpuKnown?Math.round(r.cpu_pct)+'%':(running?'…':'&ndash;');
  const memTxt=memKnown?((r.mem_used_mib>=1024?( (r.mem_used_mib/1024).toFixed(1)+'g'):(r.mem_used_mib+'m'))+'/'+r.mem_gb+'g'):(running?'…':'&ndash;');
  return {elapsedHtml,cpuPct,cpuTxt,memPct,memTxt};
}
/* Security posture, recomputed on every status poll. Every line is something the
   engine actually OBSERVED on this box, never a stored verdict the operator could
   disagree with. Only two checks are derivable today: SEC_CACHE's public-repo
   verdict and WARN_CACHE's cache-root verdict. The runner-privilege / isolation /
   ephemeral checks need FLEET_KEYS that status-json does not carry, and PHP here
   can only read fleet `default`'s config (parse_plugin_cfg reads the legacy path,
   and the selected fleet lives in localStorage, which PHP has not been told).
   d.token is a GATE, not a finding: public_repo_problem() returns before it asks
   GitHub when there is no token (runner-farm.sh:732), so an empty `security` on a
   tokenless fleet means "never asked", and calling that clear would be a lie. */
function crfPosture(d){
  const el=document.getElementById('crf-posture'); if(!el) return;
  const f=[];
  if(d.security) f.push(['Public repositories',d.security]);
  if(d.warning) f.push(['Cache root',d.warning]);
  let lvl,title,body;
  if(f.length){
    lvl='attn';
    title=d.security?'Security needs attention':'Configuration needs attention';
    // These sentences interpolate GH_REPOS and CACHE_ROOT — operator-controlled text
    // reaching the DOM through innerHTML, so crfEsc here is load-bearing, not decoration.
    // They already carry their own remediation, so nothing summarises them into a clause.
    body=f.map(x=>'<div class="crf-pf"><b>'+x[0]+'</b> '+crfEsc(x[1])+'</div>').join('');
  } else if(d.token===false){
    lvl='unknown'; title='Security · not checked';
    body='<div class="crf-pf crf-muted">The public-repository check needs a GitHub token, and this fleet has none. Add one on the Settings tab.</div>';
  } else {
    // Deliberately does NOT name what was checked. An empty `security` also means the
    // check DECLINED to run — public_repo_problem returns before asking GitHub when
    // GH_SCOPE is not `repo` or the runners are neither DinD nor socket-mounted
    // (runner-farm.sh:729-731) — and SEC_CACHE lives in tmpfs, so it is empty after
    // every reboot, and an all-curls-failed run caches an empty verdict for 300s.
    // status-json carries none of those distinctions, so "Checked: X" would be a
    // claim the engine cannot back, and a green tick is the worst place to guess.
    lvl='clear'; title='Nothing reported';
    body='<div class="crf-pf crf-muted">No public-repository or cache-root problem has been reported for this fleet.</div>';
  }
  el.className='crf-posture crf-p-'+lvl;
  // The call to action M2 could only state as prose: the security section it names is
  // on this page now, holding the keys (DinD, docker.sock, network isolation) whose
  // values these findings are about.
  el.innerHTML='<b>'+title+'</b>'+body+
    '<div class="crf-pf"><a href="#crf-cfg-security" onclick="crfCfgFocusSecurity();return false;">Review this fleet&rsquo;s security settings</a></div>';
}
const CRF_PHASE_LABEL={busy:'Busy',idle:'Idle',error:'Error',starting:'Starting'};
/* The engine's vocabulary, not a prettier one: the fleet log and the drawer speak
   these words, and there is no equivalent of `error` in a lifecycle-flavoured set.
   "exited" is the one exception — that is docker's word for the container, not a
   state the operator asked for, so it renders as Stopped. */
function crfStateLabel(r){
  if(r.state==='running') return CRF_PHASE_LABEL[r.phase]||r.phase;
  const s=String(r.state||'unknown');
  return s==='exited'?'Stopped':s.charAt(0).toUpperCase()+s.slice(1);
}
function crfRefresh(){
  // In-flight guard: never stack a new status poll while the previous is still
  // outstanding, so a slow backend can't spiral into overlapping polls.
  if(!crfFleetActive() || window.__crfBusyStatus) return;
  window.__crfBusyStatus=true;
  crfPost({action:'status-json'}).then(d=>{
    window.CRF_LAST=d;
    // #crf-warn is now a TRANSPORT channel only — the cache-root warning moved into
    // the posture block. This explicit clear is the only writer left, so a dropped
    // poll's "Lost connection" cannot pin itself to the page forever now that the
    // d.warning branch that used to hide it is gone.
    const warn=document.getElementById('crf-warn');
    if(warn&&warn.style.display!=='none'){ warn.textContent=''; warn.style.display='none'; }
    crfPosture(d);
    // Runners still on a previous baked config after a settings change — the reconciler
    // recycles them onto the new config as they go idle (busy jobs finish first).
    const mig=document.getElementById('crf-migrate');
    if(mig){ if(d.stale>0){ mig.textContent='⟳ '+d.stale+' runner'+(d.stale>1?'s':'')+' updating to the new configuration — recycling as they go idle, so running jobs finish first.'; mig.style.display='block'; } else { mig.textContent=''; mig.style.display='none'; } }
    const rs=d.runners||[];
    const up=rs.filter(r=>r.state==='running').length;
    const busy=rs.filter(r=>r.state==='running'&&r.phase==='busy').length;
    const idle=rs.filter(r=>r.state==='running'&&r.phase==='idle').length;
    const put=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v;};
    // The identity header shows this fleet's health, and status-json is 6x fresher
    // than the fleet list — fold the live counts in so the header can't sit on a
    // stale "Stopped" for half a minute after a Start.
    const me=window.CRF_FLEETS.find(x=>x.name===crfFleet());
    if(me){ me.running=up; me.configured=d.configured??me.configured; crfRenderIdentity(); crfRenderRail(); }
    // The engine ships `autoscale` as one pre-formatted string: "off" or
    // autoscale_status() ("running (pid N)" / "stopped"), with "[MIN-MAX, buffer N]"
    // appended in EVERY case (runner-farm.sh:1934) — so test the prefix, never equality.
    // The bounds are reformatted and the pid dropped: a process id is developer output,
    // and daemon liveness is already said in words by #crf-cap-dead below. The bounds
    // are NOT turned into an "up / MAX" denominator — RUNNER_COUNT is not a ceiling
    // under autoscale, and a second denominator would contradict the identity header's
    // "N of M runners" one line above.
    const as=String(d.autoscale||'off'), autoOn=!/^off\b/.test(as);
    const asb=as.match(/\[(\d+)-(\d+), buffer (\d+)\]/);
    // A scale-set fleet runs neither the autoscale nor the image-update daemon (cmd_start
    // returns before either), and RUNNER_COUNT is not its size — GitHub is. The daemon
    // whose liveness matters here is the listener, which ADR-0002 leaves UNSUPERVISED on
    // the grounds that the UI reports it dead; nothing did until this read d.scaleset, so
    // a crashed listener looked identical to an idle fleet while jobs queued on GitHub.
    // The engine ships `scaleset` pre-formatted: "off", or scaleset_status() ("running
    // (pid N)" / "stopped") with " ('<set name>')" appended — test the prefix, not equality.
    const ssOn=d.fleet_mode==='scale-set', ss=String(d.scaleset||'off');
    const ssName=(ss.match(/\('(.*)'\)$/)||[])[1]||'';
    put('crf-cap-v', (autoOn||ssOn) ? up+' online' : up+' / '+(d.configured??0)+' online');
    put('crf-cap-s', busy+' busy · '+idle+' idle');
    put('crf-cap-mode','Capacity: '+(ssOn
      ? ('GitHub scale set'+(ssName?' · '+ssName:''))
      : autoOn
      ? ('Automatic'+(asb?' · '+asb[1]+' minimum · '+asb[2]+' maximum · '+asb[3]+' warm':''))
      : ('Manual · desired '+(d.configured??0))));
    // AUTOSCALE=true with a dead daemon means the fleet stopped growing — a degraded
    // state that reads as nothing more than the word "stopped" inside that string.
    const dead=document.getElementById('crf-cap-dead');
    if(dead){
      const down=ssOn ? /^stopped\b/.test(ss) : (autoOn&&/^stopped\b/.test(as));
      if(down) dead.textContent=ssOn
        ? 'The scale-set listener is not running — GitHub jobs will queue until it is started.'
        : 'Autoscale is enabled but its daemon is not running.';
      dead.hidden=!down;
    }
    // Image auto-update keeps a home here (variant D drops it entirely): it carries
    // daemon liveness the toggle on Settings cannot, and the two background daemons
    // that resize the fleet belong together.
    // Same treatment: imageupdate_status() embeds a pid the operator has no use for.
    // Same treatment for the listener, which takes this slot on a scale-set fleet: image
    // auto-update is always "off" there (its rollover recreates runners, which a JIT
    // runner cannot be), so printing it would report on a daemon that cannot exist.
    put('crf-cap-iu', ssOn
      ? 'Scale-set listener: '+ss.replace(/\s*\(pid \d+\)/,'')
      : 'Image auto-update: '+String(d.image_autoupdate||'off').replace(/\s*\(pid \d+\)/,''));
    window.CRF_UP=up; crfRenderQueue();
    const tb=document.getElementById('crf-bays-body'); if(!tb) return;
    // Capture the open drawer's LIVE scroll before the rebuild below destroys the
    // node, so crfDrawerMount can restore the user's position (not snap to tail).
    const odr=window.CRF_DRAWER&&document.querySelector('.crf-bay-drawer[data-for="'+window.CRF_DRAWER+'"]');
    if(odr){ window.CRF_DRAWER_PINNED=crfDrawerPinned(odr); window.CRF_DRAWER_SCROLL=odr.scrollTop; }
    if(!rs.length){
      tb.innerHTML='<div class="crf-empty"><span class="crf-ball"></span>'+
        '<div><strong>No managed runners</strong><div class="crf-muted">Configured for '+crfEsc(d.configured||0)+' — start the fleet to register them with GitHub.</div></div>'+
        '<uui-button size="sm"'+(crfDark()?' class="dark"':'')+' onclick="crfAction(\'start\')">Start the fleet</uui-button></div>';
      return;
    }
    // In-place fast-path: rebuilding crf-bays-body's innerHTML every 5s drops keyboard
    // focus / text selection on each poll.
    // Most polls are steady-state — same runners and jobs, only CPU/mem/elapsed ticking —
    // so when the STRUCTURE is unchanged we refresh just those volatile cells in place and
    // leave the rows (and the open drawer sibling) alive. Any structural change (runner
    // added/removed, phase flip, new job, drawer toggle) changes the signature
    // and falls through to the full rebuild below. busy-with-job_started is in the
    // signature so the .crf-elapsed span's presence always matches what the row was built
    // with — the in-place branch can then update it without ever needing to create it.
    const sig=JSON.stringify([window.CRF_DRAWER,rs.map(r=>[r.name,r.state,r.phase,r.job,r.repo,r.run_id,r.pr,r.branch,r.cpus,r.mem_gb,r.state==='running'&&r.phase==='busy'&&!!r.job_started])]);
    if(tb.__crfSig===sig && tb.querySelector('.crf-bay[data-name]')){
      rs.forEach(r=>{
        const row=tb.querySelector('.crf-bay[data-name="'+(window.CSS&&CSS.escape?CSS.escape(r.name):r.name)+'"]'); if(!row) return;
        const v=crfVolatile(r);
        const u=row.querySelectorAll('.crf-usage');
        if(u[0]) u[0].innerHTML=crfBar(v.cpuPct)+'<span class="crf-uval">'+v.cpuTxt+'</span>';
        if(u[1]) u[1].innerHTML=crfBar(v.memPct)+'<span class="crf-uval">'+v.memTxt+'</span>';
        const el=row.querySelector('.crf-elapsed');
        if(el&&r.job_started){ const e=crfElapsed(r.job_started); if(e){ el.textContent=e.txt; el.title='running for '+e.txt; el.className='crf-elapsed'+(e.m>=120?' crf-el-hot':e.m>=30?' crf-el-warn':''); } }
      });
      crfDrawerMount();
      return;
    }
    tb.__crfSig=sig;
    tb.innerHTML=rs.map(r=>{
      const running=r.state==='running';
      const ball=running?('crf-ball-'+r.phase):'crf-ball';
      let repoHtml='\u2014', metaHtml;
      const v=crfVolatile(r);
      if(running&&r.phase==='busy'){
        // repo/pr/branch/run_id are scraped from the job process environ, and the engine
        // only populates them for a BUSY runner (runner-farm.sh:1851) \u2014 any other state
        // renders the dash rather than a stale last value.
        const repoTxt=crfEsc(r.repo||''), runOk=/^\d+$/.test(r.run_id||'');
        // The full owner/name now owns its own line instead of being truncated to the
        // last path segment; the link moves up onto it so the job name below stays
        // plain text and stays readable when it is long.
        if(r.repo) repoHtml=runOk
          ? '<a href="https://github.com/'+repoTxt+'/actions/runs/'+r.run_id+'" target="_blank" rel="noopener" title="open this run on GitHub">'+repoTxt+'</a>'
          : repoTxt;
        metaHtml=crfEsc(r.job||'\u2014');
        // pr and branch are mutually exclusive by construction (runner-farm.sh:1862),
        // so this is exhaustive, not a fallback.
        if(/^\d+$/.test(r.pr||'')&&r.repo) metaHtml+='<a class="crf-ref" href="https://github.com/'+repoTxt+'/pull/'+r.pr+'" target="_blank" rel="noopener">#'+r.pr+'</a>';
        else if(r.branch) metaHtml+='<span class="crf-ref">'+crfEsc(r.branch)+'</span>';
        metaHtml+=v.elapsedHtml;
      } else {
        // Both lines still render, so an idle row keeps the same height as a busy one
        // and the table does not reflow every time a job starts.
        metaHtml=running?'Waiting for a job':'\u2014';
      }
      return '<div class="crf-bay" data-name="'+crfEsc(r.name)+'" tabindex="0" role="button" aria-expanded="'+(window.CRF_DRAWER===r.name?'true':'false')+'" aria-label="Runner '+crfEsc(r.name)+', toggle log">'+
        '<span class="crf-ball '+ball+'"></span>'+
        '<span class="crf-name">'+crfEsc(r.name)+'</span>'+
        '<span class="crf-state">'+crfEsc(crfStateLabel(r))+'</span>'+
        '<span class="crf-job" title="'+crfEsc(r.job||'')+'"><span class="crf-repo">'+repoHtml+'</span><span class="crf-job-m crf-muted">'+metaHtml+'</span></span>'+
        '<span class="crf-usage">'+crfBar(v.cpuPct)+'<span class="crf-uval">'+v.cpuTxt+'</span></span>'+
        '<span class="crf-usage">'+crfBar(v.memPct)+'<span class="crf-uval">'+v.memTxt+'</span></span>'+
        '<span class="crf-recycle" tabindex="0" role="button" aria-label="Recycle '+crfEsc(r.name)+'" title="Recycle this runner">&#10227;</span>'+
      '</div>';
    }).join('');
    crfDrawerMount();
  }).catch(e=>{
    // A dropped status poll because the selection moved while it was in flight is
    // crfPost's stale-reject (e.__crfStale): the next poll is already underway for
    // the right fleet. Paint nothing, log nothing — the real fleet's data will
    // arrive in < 5s.
    if(e&&e.__crfStale) return;
    // A rejected status poll (network down, or a 403 from a CSRF token that expired
    // on a reboot/array restart) must NOT look like an empty fleet — surface it in
    // the warning banner and keep the last-rendered bays in place. Cleared by the
    // next successful poll (see the explicit clear at the top of .then).
    const warn=document.getElementById('crf-warn');
    if(warn){ warn.textContent='⚠ '+(String((e&&e.message)||'').indexOf('session expired')>=0?'Session expired — reload the page to reconnect.':'Lost connection to the server — retrying…'); warn.style.display='block'; }
    console.error('ci-runner-farm status:',e);
  }).finally(()=>{ window.__crfBusyStatus=false; });
}
window.CRF_QUEUED=undefined; window.CRF_QUEUED_AGE=undefined; window.CRF_UP=0;
crfRefresh(); setInterval(crfRefresh,5000);
/* The queue card mixes two pollers: depth comes from queued-json (30s) and the
   runners-online it is judged against comes from status-json (5s). Both write a
   global and re-render through here, because judging urgency inside crfQueued
   alone would weigh today's queue against a 30s-old runner count. */
function crfRenderQueue(){
  const q=window.CRF_QUEUED, up=window.CRF_UP;
  const v=document.getElementById('crf-q-v'), s=document.getElementById('crf-q-s');
  if(!v||!s) return;
  // undefined means not fetched yet; null means the engine answered -1. Keeping them
  // apart stops the 5s status poll from claiming "Unavailable" in the gap before the
  // first queued-json of a page load or a fleet switch lands.
  if(q===undefined) return;
  if(typeof q!=='number'){
    // -1 means "could not ask" \u2014 but it is ALSO what a fleet reports before anyone
    // has asked at all: QUEUED_CACHE lives in tmpfs, so it is absent after every reboot
    // and on a new fleet's first poll. The engine seeds `age` to 999999 when the file
    // is missing (runner-farm.sh:1697), which is the only way to tell the two apart.
    // Blaming GitHub for not answering a call that was never placed sends an operator
    // to check a PAT that is fine.
    const asked=typeof window.CRF_QUEUED_AGE==='number'&&window.CRF_QUEUED_AGE<3600;
    if((window.CRF_LAST||{}).token===false){
      v.textContent='Unavailable';
      s.textContent='No GitHub token configured \u2014 queue depth cannot be read.';
    } else if(!asked){
      v.textContent='\u2013';
      s.textContent='Checking GitHub\u2026';
    } else {
      v.textContent='Unavailable';
      s.textContent='GitHub did not answer \u2014 retrying.';
    }
    s.className='crf-stat-small crf-muted';
    return;
  }
  // No colour here on purpose. Colour on this page means HEALTH, and a queue deeper
  // than the fleet is saturation \u2014 the fleet is working exactly as configured. Say it
  // in the sub-line instead. (Variant D's other urgency trigger, oldest job >= 5
  // minutes, needs a per-job age queued-json does not carry: its `age` is the CACHE's.)
  v.textContent=q+' job'+(q===1?'':'s')+' waiting';
  s.textContent=q===0?'Nothing waiting'
    :((typeof up==='number'&&q>up)?'More jobs waiting than runners online.':'Runners are picking them up.');
  s.className='crf-stat-small crf-muted';
}
function crfQueued(){
  if(!crfFleetActive()) return;
  crfPost({action:'queued-json'}).then(d=>{
    window.CRF_QUEUED=(typeof d.queued==='number'&&d.queued>=0)?d.queued:null;
    window.CRF_QUEUED_AGE=typeof d.age==='number'?d.age:undefined;
    crfRenderQueue();
  }).catch(()=>{});
}
crfQueued(); setInterval(crfQueued,30000);
function crfBytes(b){ if(typeof b!=='number'||b<0) return '\u2013'; const u=['B','K','M','G','T']; let i=0,v=b; while(v>=1024&&i<u.length-1){v/=1024;i++;} return (i===0?v:(v>=10?Math.round(v):v.toFixed(1)))+u[i]; }
/* Three states the old single dash collapsed into one: a cache root the engine
   REJECTED as unsafe (-1 from cmd_cache_usage_refresh), a safe root that has not
   been created yet (0), and a real measurement. The middle one used to render as
   "0B", which told an operator their caches were empty rather than absent. */
function crfRenderStorage(){
  const d=window.CRF_CACHE||{}, v=document.getElementById('crf-st-v'), s=document.getElementById('crf-st-s');
  if(!v||!s) return;
  // total=-1 carries THREE different meanings: the cache root failed its safety check
  // (runner-farm.sh:1611), du returned nothing on a perfectly safe root (:1616), and
  // "no measurement exists yet" — CACHEUSE_CACHE is in tmpfs, so it is absent after
  // every reboot and on a fleet's first poll. `age` separates the last one out: the
  // engine seeds it to 999999 when the file is missing (:1624). Telling an operator
  // their CACHE_ROOT is unsafe when it was simply never measured sends them to fix a
  // setting that is fine, so the remaining two share one honest sentence.
  const measured=typeof d.age==='number'&&d.age<3600;
  if(typeof d.total!=='number'||(d.total<0&&!measured)){ v.textContent='–'; s.textContent='Measuring…'; return; }
  if(d.total<0){
    v.textContent='Unavailable';
    s.textContent='The engine could not measure the cache root — check that CACHE_ROOT points at a dedicated folder on a pool.';
    return;
  }
  v.textContent=crfBytes(d.total)+' cache';
  s.textContent = d.total===0 ? 'The cache root does not exist yet — it appears on the first run.'
    : (d.pkg>0 ? crfBytes(d.pkg)+' reclaimable' : 'Nothing to reclaim');
}
function crfCacheUsage(){
  if(!crfFleetActive()) return;
  crfPost({action:'cache-usage'}).then(d=>{
    window.CRF_CACHE=d;
    crfRenderStorage();
    const clr=document.getElementById('crf-cache-clear'); if(clr) clr.title=(d.pkg>0?crfBytes(d.pkg)+' reclaimable':'');
  }).catch(()=>{});
}
crfCacheUsage(); setInterval(crfCacheUsage,30000);
function crfStats(){
  if(!crfFleetActive()) return;
  crfPost({action:'stats-json'}).then(d=>{
    const put=(id,v)=>{const e=document.getElementById(id); if(e) e.textContent=v;};
    const dash='\u2013';
    if(!(typeof d.total==='number'&&d.total>=0)){  // no token / API down — signal, don't show a confident 0
      put('crf-rs-ok',dash); put('crf-rs-fail',dash); put('crf-rs-cancel',dash); put('crf-rs-rate',dash);
      put('crf-rs-total',dash+' total across your repos'); return;
    }
    const settled=(d.ok||0)+(d.fail||0)+(d.cancel||0);
    put('crf-rs-ok',d.ok??dash); put('crf-rs-fail',d.fail??dash); put('crf-rs-cancel',d.cancel??dash);
    put('crf-rs-rate', settled>0 ? Math.round(100*(d.ok||0)/settled)+'%' : dash);
    put('crf-rs-total', d.total+' total across your repos');
  }).catch(()=>{});
}
crfStats(); setInterval(crfStats,60000);
function crfCacheClear(){
  const pkg=(window.CRF_CACHE&&window.CRF_CACHE.pkg)||0;
  const doIt=()=>crfPost({action:'cache-clear'})
    .then(o=>{ crfToast(o.ok?'Package caches cleared':('Clear failed'+(o.error?': '+o.error:''))); crfCacheUsage(); })
    .catch(e=>{ crfToast('Clear failed'); console.error('ci-runner-farm cache-clear:',e); });
  const msg='Removes '+crfBytes(pkg)+' of warm cargo, npm, yarn, pnpm, sccache, and Playwright caches. Running jobs keep working (a cache miss at worst); workspaces and Docker data are left intact.';
  if(window.swal){ swal({title:'Clear package caches?',text:msg,type:'warning',showCancelButton:true,confirmButtonText:'Clear caches',cancelButtonText:'Cancel'},ok=>{ if(ok) doIt(); }); }
  else if(confirm('Clear package caches? '+msg)) doIt();
}
function crfRecycle(name){
  const r=((window.CRF_LAST||{}).runners||[]).find(x=>x.name===name)||{};
  const go=()=>crfPost({action:'recycle',name})
    .then(o=>{ crfToast(o.ok?('Recycled '+name):('Recycle failed'+(o.error?': '+o.error:''))); crfRefresh(); })
    .catch(e=>{ crfToast('Recycle failed'); console.error('ci-runner-farm recycle:',e); });
  if(r.state==='running'&&r.phase==='busy'&&window.swal){
    swal({title:'Recycle '+name+'?',text:'It is mid-job'+(r.job?': '+r.job:'')+'.\nThe job will fail and re-queue.',type:'warning',showCancelButton:true,confirmButtonText:'Recycle',cancelButtonText:'Cancel'},ok=>{ if(ok) go(); });
  } else go();
}
/* Click a bay to open a live log drawer for that runner. It persists across the
   5s re-render: crfRefresh rebuilds crf-bays-body's innerHTML (destroying this
   node), so we cache the last log + scroll position and restore them on re-mount
   rather than flashing "loading…" and yanking the view back to the tail. The live
   scroll is captured in crfRefresh just before the rebuild (see CRF_DRAWER_SCROLL). */
window.CRF_DRAWER=null; window.CRF_DRAWER_HTML=''; window.CRF_DRAWER_SCROLL=0; window.CRF_DRAWER_PINNED=true;
function crfDrawerPinned(el){ return el.scrollHeight-el.scrollTop-el.clientHeight < 24; }
function crfDrawerFill(name){
  crfPost({action:'runner-log',name}).then(d=>{
    const el=document.querySelector('.crf-bay-drawer[data-for="'+name+'"]');
    if(el&&window.CRF_DRAWER===name){
      const pinned=crfDrawerPinned(el), prev=el.scrollTop;
      window.CRF_DRAWER_HTML=crfColorize(d.log||'(no output)');
      el.innerHTML=window.CRF_DRAWER_HTML;
      // Stick to the tail only if the user was already there; otherwise keep their
      // place so reading a mid-log error isn't interrupted on the next poll.
      el.scrollTop = pinned ? el.scrollHeight : prev;
      window.CRF_DRAWER_SCROLL=el.scrollTop; window.CRF_DRAWER_PINNED=pinned;
    }
  }).catch(()=>{});
}
function crfDrawerMount(){
  document.querySelectorAll('.crf-bay-drawer').forEach(e=>{ if(e.dataset.for!==window.CRF_DRAWER) e.remove(); });
  if(!window.CRF_DRAWER) return;
  if(document.querySelector('.crf-bay-drawer[data-for="'+window.CRF_DRAWER+'"]')){
    crfDrawerFill(window.CRF_DRAWER);
    return;
  }
  const row=document.querySelector('#crf-bays-body .crf-bay[data-name="'+window.CRF_DRAWER+'"]');
  if(!row) return;
  const d=document.createElement('div'); d.className='crf-bay-drawer'; d.dataset.for=window.CRF_DRAWER;
  // Re-seed with the last log so a 5s re-render doesn't flash "loading…"; only the
  // very first open (no cached HTML) shows the placeholder.
  d.innerHTML=window.CRF_DRAWER_HTML||'<span class="crf-muted">loading log...</span>';
  row.after(d);
  if(window.CRF_DRAWER_HTML) d.scrollTop = window.CRF_DRAWER_PINNED ? d.scrollHeight : window.CRF_DRAWER_SCROLL;
  crfDrawerFill(window.CRF_DRAWER);
}
function crfToggleDrawer(name){
  const opening = window.CRF_DRAWER!==name;
  window.CRF_DRAWER = opening ? name : null;
  window.CRF_DRAWER_HTML=''; window.CRF_DRAWER_SCROLL=0; window.CRF_DRAWER_PINNED=true; // fresh cache per open
  const row=document.querySelector('#crf-bays-body .crf-bay[data-name="'+name+'"]');
  if(row) row.setAttribute('aria-expanded', opening?'true':'false');
  crfDrawerMount();
}
document.getElementById('crf-bays-body').addEventListener('click',e=>{
  const rc=e.target.closest('.crf-recycle');
  if(rc){ const b=rc.closest('.crf-bay[data-name]'); if(b) crfRecycle(b.dataset.name); return; }
  if(e.target.closest('a,uui-button,.crf-bay-drawer')) return;
  const row=e.target.closest('.crf-bay[data-name]'); if(!row) return;
  crfToggleDrawer(row.dataset.name);
});
document.getElementById('crf-bays-body').addEventListener('keydown',e=>{
  if(e.key!=='Enter'&&e.key!==' ') return;
  const rc=e.target.closest('.crf-recycle');
  if(rc){ e.preventDefault(); const b=rc.closest('.crf-bay[data-name]'); if(b) crfRecycle(b.dataset.name); return; }
  const row=e.target.closest('.crf-bay[data-name]');
  if(row&&e.target===row){ e.preventDefault(); crfToggleDrawer(row.dataset.name); }
});
/* No separate drawer-refresh timer: crfRefresh() rebuilds the bays and calls
   crfDrawerMount() every cycle (and is itself gated by crfFleetActive()), which
   re-fills the open drawer. A second interval here double-fetched runner-log and
   ignored the sub-tab guard, so it kept hitting docker on the NAS off-tab. */
/* Pause all polling while the tab is hidden (each poller costs a docker
   stats + per-runner exec on the NAS); refresh immediately on return. */
document.addEventListener('visibilitychange',()=>{
  if(document.hidden) return;
  crfRefresh(); crfQueued(); crfFarmLog(); crfCacheUsage(); crfStats(); crfFleetList();
  if(window.CRF_DRAWER) crfDrawerFill(window.CRF_DRAWER);
});
/* Switching to the Fleet dynamix sub-tab doesn't fire visibilitychange; refresh
   on its tab button so the paused pollers catch up immediately, not in 5s. */
document.getElementById('tab1') && document.getElementById('tab1').addEventListener('click',()=>{
  setTimeout(()=>{ crfRefresh(); crfQueued(); crfFarmLog(); crfCacheUsage(); crfStats(); crfFleetList(); },60);
});
</script>
